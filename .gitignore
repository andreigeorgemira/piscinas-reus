# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
.next/
# The trailing slash in `.next/` does not cover this: it is a sibling
# directory, not a child. Playwright's dev server builds here so it does not
# fight the developer's server for the per-directory `next dev` lock.
.next-e2e/
out/
build/
next-env.d.ts

# production
dist/

# misc
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - NEVER COMMIT
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# supabase
.branches
.temp
supabase/.temp/

# QA artefacts from browser-driven checks
.playwright-mcp/
/*.png
